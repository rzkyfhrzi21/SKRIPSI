        <mxCell id="d1" value="&lt;b&gt;🗄️ Relational Database (MySQL)&lt;/b&gt;&lt;br&gt;• Tabel Data Master Kos (Atribut, Fasilitas, Koordinat GPS)&lt;br&gt;• Tabel Konfigurasi Kriteria SAW (Biaya &amp; Keuntungan)&lt;br&gt;• Tabel Kredensial Administrator (Password Hash Terenkripsi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="t3">
          <mxGeometry x="30" y="35" width="450" height="80" as="geometry" />
