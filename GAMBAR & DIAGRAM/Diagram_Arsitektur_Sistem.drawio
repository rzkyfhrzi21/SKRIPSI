        <mxCell id="mob_user" value="&lt;b&gt;Aplikasi Mobile Mahasiswa&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Flutter / Android SDK)&lt;/i&gt;&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• Eksplorasi kos sekitar kampus&lt;br&gt;• Input preferensi bobot 6 kriteria&lt;br&gt;• Perangkingan rekomendasi kos&lt;br&gt;• Rute jalan via Google Maps&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontColor=#1E293B;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
