        <mxCell id="mob_admin" value="&lt;b&gt;Aplikasi Mobile Administrator&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Flutter / Mobile Dashboard)&lt;/i&gt;&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• Autentikasi login smartphone&lt;br&gt;• Manajemen data master kos&lt;br&gt;• Validasi koordinat GPS (Lat/Long)&lt;br&gt;• Sinkronisasi rekap kuesioner&lt;br&gt;• Konfigurasi default kriteria SAW&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontSize=11;fontColor=#1E293B;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
