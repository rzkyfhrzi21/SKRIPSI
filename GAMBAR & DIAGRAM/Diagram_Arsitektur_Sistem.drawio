        <mxCell id="maps_api" value="&lt;b&gt;Google Maps Platform API&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Cloud Geolocation Service)&lt;/i&gt;&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• Geocoding &amp;amp; Reverse Geocoding&lt;br&gt;• Validasi titik bujur &amp;amp; lintang&lt;br&gt;• Direction Navigation URL&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontSize=11;fontColor=#1E293B;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
