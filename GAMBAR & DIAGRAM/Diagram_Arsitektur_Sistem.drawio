        <mxCell id="db_mysql" value="&lt;b&gt;Database MySQL&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Relational Database / Port 3306)&lt;/i&gt;&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• &lt;b&gt;tb_pengguna&lt;/b&gt; (Admin auth)&lt;br&gt;• &lt;b&gt;tb_kos&lt;/b&gt; (Master data &amp;amp; GPS)&lt;br&gt;• &lt;b&gt;tb_kriteria&lt;/b&gt; (6 Kriteria SAW)&lt;br&gt;• &lt;b&gt;tb_bobot&lt;/b&gt; (Bobot kriteria)&lt;br&gt;• &lt;b&gt;tb_penilaian&lt;/b&gt; (Rating kuesioner)&lt;br&gt;• &lt;b&gt;tb_rekomendasi&lt;/b&gt; (Log hasil Vi)&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=2;fontSize=11;fontColor=#1E293B;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
