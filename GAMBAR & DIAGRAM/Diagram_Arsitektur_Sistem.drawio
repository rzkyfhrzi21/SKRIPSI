        </mxCell>

        
        <mxCell id="be_service" value="&lt;b&gt;Backend REST API Service (Go)&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Gin Gonic / Native Go Service)&lt;/i&gt;&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• Router RESTful API &amp;amp; Handler JSON&lt;br&gt;• Middleware JWT Auth &amp;amp; CORS&lt;br&gt;• &lt;b&gt;Engine Haversine Distance&lt;/b&gt; (R: 6.371 km)&lt;br&gt;• &lt;b&gt;Engine SAW:&lt;/b&gt;&lt;br&gt;  - Normalisasi Cost &amp;amp; Benefit&lt;br&gt;  - Nilai Preferensi Vi = Σ(wj * rij)&lt;br&gt;• Sorting Descending Peringkat Kos&lt;br&gt;• JSON Response Serialization&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=11;fontColor=#1E293B;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
