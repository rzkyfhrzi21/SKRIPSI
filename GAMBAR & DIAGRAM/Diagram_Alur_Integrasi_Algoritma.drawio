<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="pipeline_landscape" name="Alur Integrasi Landscape (Kiri ke Kanan)">
    <mxGraphModel dx="1450" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#000000;" value="&lt;b style=&quot;font-size: 16px; color: rgb(0, 0, 0);&quot;&gt;ALUR INTEGRASI METODE HAVERSINE DISTANCE DAN SIMPLE ADDITIVE WEIGHTING (SAW)&lt;/b&gt;" vertex="1">
          <mxGeometry height="55" width="1520" x="30" y="25" as="geometry" />
        </mxCell>

        <mxCell id="step1_header" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;" value="&lt;b style=&#39;color:#000000;font-size:12px;&#39;&gt;TAHAP 1: INPUT KOORDINAT LOKASI&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="250" x="30" y="105" as="geometry" />
        </mxCell>

        <mxCell id="box_input_kampus" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#000000;spacing=6;" value="&lt;b style=&#39;color:#000000;font-size:12px;&#39;&gt;Titik Acuan Kampus&lt;br&gt;IIB Darmajaya&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#000000;&#39;&gt;Koordinat Gerbang Utama:&lt;br&gt;&lt;b&gt;Lintang = -5.3789&amp;deg; LS&lt;br&gt;Bujur = 105.2538&amp;deg; BT&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="165" width="250" x="30" y="145" as="geometry" />
        </mxCell>

        <mxCell id="box_input_kos" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#000000;spacing=6;" value="&lt;b style=&#39;color:#000000;font-size:12px;&#39;&gt;Titik Lokasi Alternatif Kos (A&lt;sub&gt;i&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#000000;&#39;&gt;Pendataan Titik Lokasi&lt;br&gt;(Google Maps):&lt;br&gt;&lt;b&gt;Koordinat Lintang &amp;amp; Bujur&lt;br&gt;Setiap Tempat Kos&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="165" width="250" x="30" y="340" as="geometry" />
        </mxCell>

        <mxCell id="arr_in1" edge="1" parent="1" source="box_input_kampus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=2;" target="box_haversine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_in2" edge="1" parent="1" source="box_input_kos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=2;" target="box_haversine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="box_haversine" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;fontColor=#000000;" value="&lt;b style=&#39;font-size:13px;color:#000000;&#39;&gt;TAHAP 2:&lt;br&gt;PERHITUNGAN JARAK LOKASI&lt;br&gt;(METODE HAVERSINE DISTANCE)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#000000;&#39;&gt;&lt;b&gt;1.&lt;/b&gt; Menghitung selisih koordinat lintang (&amp;Delta;&amp;phi;) dan bujur (&amp;Delta;&amp;lambda;) antara kampus dan kos dalam radian&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Menghitung sudut kelengkungan jarak menggunakan rumus trigonometri Haversine&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Menghasilkan jarak lokasi kos ke kampus:&lt;br&gt;&lt;b style=&#39;color:#000000;font-size:12px;&#39;&gt;d&lt;sub&gt;i&lt;/sub&gt; = R &amp;times; c (satuan meter)&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="360" width="280" x="330" y="145" as="geometry" />
        </mxCell>

        <mxCell id="arr_bridge" edge="1" parent="1" source="box_haversine" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=2.5;labelBackgroundColor=#FFFFFF;fontColor=#000000;" target="box_c2" value="&lt;b style=&#39;color:#000000;background-color:#FFFFFF;font-size:10px;&#39;&gt;Jarak (d&lt;sub&gt;i&lt;/sub&gt;)&lt;br&gt;Otomatis&lt;br&gt;Jadi C&lt;sub&gt;2&lt;/sub&gt;&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="box_bridge_group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;align=center;verticalAlign=top;spacingTop=6;fontColor=#000000;" value="" vertex="1">
          <mxGeometry height="430" width="290" x="680" y="105" as="geometry" />
        </mxCell>

        <mxCell id="lbl_group_criteria" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;" value="&lt;b style=&#39;color:#000000;font-size:12px;&#39;&gt;TAHAP 3: PENYUSUNAN 6 KRITERIA&lt;br&gt;&amp;amp; BOBOT PREFERENSI MAHASISWA&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="270" x="690" y="112" as="geometry" />
        </mxCell>

        <mxCell id="box_c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#000000;" value="&lt;b style=&#39;color:#000000;font-size:11px;&#39;&gt;Kriteria Jarak ke Kampus (C&lt;sub&gt;2&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#000000;&#39;&gt;&lt;b&gt;Bersumber dari Hasil Haversine (d&lt;sub&gt;i&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;Sifat Kriteria: &lt;b&gt;Cost (Biaya)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Semakin dekat jarak, nilai semakin tinggi&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="695" y="155" as="geometry" />
        </mxCell>

        <mxCell id="box_c_other" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontColor=#000000;" value="&lt;b style=&quot;color: rgb(0, 0, 0);font-size:11px;&quot;&gt;5 Kriteria Penilaian Kos Lainnya&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(0, 0, 0);&quot;&gt;&amp;bull; C&lt;sub&gt;1&lt;/sub&gt; Harga Sewa (Cost: Semakin murah baik)&lt;br&gt;&amp;bull; C&lt;sub&gt;3&lt;/sub&gt; Fasilitas &amp;amp; C&lt;sub&gt;4&lt;/sub&gt; Luas (Benefit: Skala 1&amp;ndash;5)&lt;br&gt;&amp;bull; C&lt;sub&gt;5&lt;/sub&gt; Kebersihan &amp;amp; C&lt;sub&gt;6&lt;/sub&gt; Keamanan (Benefit: 1&amp;ndash;5)&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="260" x="695" y="280" as="geometry" />
        </mxCell>

        <mxCell id="box_weights" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#000000;" value="&lt;b style=&#39;color:#000000;font-size:11px;&#39;&gt;Bobot Kriteria (W)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#000000;&#39;&gt;&lt;b&gt;Bobot W&lt;sub&gt;1&lt;/sub&gt; s.d. W&lt;sub&gt;6&lt;/sub&gt; (Total = 100%)&lt;/b&gt;&lt;br&gt;Diperoleh dari kuesioner / prioritas mahasiswa&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="260" x="695" y="415" as="geometry" />
        </mxCell>

        <mxCell id="arr_to_saw" edge="1" parent="1" source="box_bridge_group" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=2.5;" target="box_saw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="box_saw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;fontColor=#000000;" value="&lt;b style=&#39;font-size:13px;color:#000000;&#39;&gt;TAHAP 4:&lt;br&gt;PERHITUNGAN &amp;amp; PERANGKINGAN&lt;br&gt;METODE SAW&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#000000;&#39;&gt;&lt;b&gt;1. Normalisasi Matriks (R):&lt;/b&gt;&lt;br&gt;Menyamakan skala kriteria ke rentang 0 s.d. 1&lt;br&gt;&amp;bull; &lt;b&gt;Cost (C&lt;sub&gt;1&lt;/sub&gt;, C&lt;sub&gt;2&lt;/sub&gt;):&lt;/b&gt; R&lt;sub&gt;ij&lt;/sub&gt; = Nilai Terkecil / Nilai Kos&lt;br&gt;&amp;bull; &lt;b&gt;Benefit (C&lt;sub&gt;3&lt;/sub&gt;&amp;ndash;C&lt;sub&gt;6&lt;/sub&gt;):&lt;/b&gt; R&lt;sub&gt;ij&lt;/sub&gt; = Nilai Kos / Nilai Terbesar&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Perhitungan Nilai Akhir Preferensi (V&lt;sub&gt;i&lt;/sub&gt;):&lt;/b&gt;&lt;br&gt;Mengalikan nilai normalisasi dgn bobot kriteria:&lt;br&gt;&lt;b style=&#39;color:#000000;font-size:12px;&#39;&gt;V&lt;sub&gt;i&lt;/sub&gt; = &amp;sum; (W&lt;sub&gt;j&lt;/sub&gt; &amp;times; R&lt;sub&gt;ij&lt;/sub&gt;) (j = 1 s.d. 6)&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="360" width="280" x="1020" y="145" as="geometry" />
        </mxCell>

        <mxCell id="arr_to_rank" edge="1" parent="1" source="box_saw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=2.5;" target="box_ranking">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="box_ranking" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;fontColor=#000000;" value="&lt;b style=&#39;font-size:13px;color:#000000;&#39;&gt;HASIL AKHIR:&lt;br&gt;PERINGKAT REKOMENDASI&lt;br&gt;TEMPAT KOS TERBAIK&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#000000;&#39;&gt;&amp;bull; Mengurutkan tempat kos dari nilai akhir (V&lt;sub&gt;i&lt;/sub&gt;) tertinggi hingga terendah&lt;br&gt;&lt;br&gt;&amp;bull; Kos dengan nilai V&lt;sub&gt;i&lt;/sub&gt; tertinggi menjadi &lt;b style=&#39;color:#000000;&#39;&gt;Peringkat 1 (Rekomendasi Terbaik)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Menampilkan daftar kos beserta harga, jarak, fasilitas, dan rute peta pada aplikasi&lt;/font&gt;" vertex="1">
          <mxGeometry height="360" width="200" x="1350" y="145" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
