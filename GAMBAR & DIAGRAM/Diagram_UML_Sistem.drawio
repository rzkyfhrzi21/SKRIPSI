        <mxCell id="b_ext" value="&lt;b&gt;DATA &amp;amp; EXTERNAL API LAYER&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="760" y="40" width="280" height="480" as="geometry" />
        </mxCell>

        
        <mxCell id="mob_user" value="&lt;b&gt;Aplikasi Mobile Mahasiswa&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Flutter / Android SDK)&lt;/i&gt;&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• Eksplorasi kos sekitar kampus&lt;br&gt;• Input preferensi bobot 6 kriteria&lt;br&gt;• Perangkingan rekomendasi kos&lt;br&gt;• Rute jalan via Google Maps&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontColor=#1E293B;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="240" height="180" as="geometry" />
        </mxCell>

        
        <mxCell id="mob_admin" value="&lt;b&gt;Aplikasi Mobile Administrator&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Flutter / Mobile Dashboard)&lt;/i&gt;&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• Autentikasi login smartphone&lt;br&gt;• Manajemen data master kos&lt;br&gt;• Validasi koordinat GPS (Lat/Long)&lt;br&gt;• Sinkronisasi rekap kuesioner&lt;br&gt;• Konfigurasi default kriteria SAW&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontSize=11;fontColor=#1E293B;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="240" height="190" as="geometry" />
        </mxCell>

        
        <mxCell id="be_service" value="&lt;b&gt;Backend REST API Service (Go)&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Gin Gonic / Native Go Service)&lt;/i&gt;&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• Router RESTful API &amp;amp; Handler JSON&lt;br&gt;• Middleware JWT Auth &amp;amp; CORS&lt;br&gt;• &lt;b&gt;Engine Haversine Distance&lt;/b&gt; (R: 6.371 km)&lt;br&gt;• &lt;b&gt;Engine SAW:&lt;/b&gt;&lt;br&gt;  - Normalisasi Cost &amp;amp; Benefit&lt;br&gt;  - Nilai Preferensi Vi = Σ(wj * rij)&lt;br&gt;• Sorting Descending Peringkat Kos&lt;br&gt;• JSON Response Serialization&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=11;fontColor=#1E293B;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="405" y="80" width="270" height="410" as="geometry" />
        </mxCell>

        
        <mxCell id="maps_api" value="&lt;b&gt;Google Maps Platform API&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Cloud Geolocation Service)&lt;/i&gt;&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• Geocoding &amp;amp; Reverse Geocoding&lt;br&gt;• Validasi titik bujur &amp;amp; lintang&lt;br&gt;• Direction Navigation URL&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontSize=11;fontColor=#1E293B;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="785" y="80" width="230" height="160" as="geometry" />
        </mxCell>

        
        <mxCell id="db_mysql" value="&lt;b&gt;Database MySQL&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Relational Database / Port 3306)&lt;/i&gt;&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• &lt;b&gt;tb_pengguna&lt;/b&gt; (Admin auth)&lt;br&gt;• &lt;b&gt;tb_kos&lt;/b&gt; (Master data &amp;amp; GPS)&lt;br&gt;• &lt;b&gt;tb_kriteria&lt;/b&gt; (6 Kriteria SAW)&lt;br&gt;• &lt;b&gt;tb_bobot&lt;/b&gt; (Bobot kriteria)&lt;br&gt;• &lt;b&gt;tb_penilaian&lt;/b&gt; (Rating kuesioner)&lt;br&gt;• &lt;b&gt;tb_rekomendasi&lt;/b&gt; (Log hasil Vi)&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=2;fontSize=11;fontColor=#1E293B;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="785" y="270" width="230" height="220" as="geometry" />
        </mxCell>

        
        <mxCell id="edge_user_be" value="&lt;b&gt;JSON / HTTPS&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2.2;endArrow=classic;startArrow=classic;fontSize=10;fontColor=#1E40AF;" edge="1" parent="1" source="mob_user" target="be_service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_admin_be" value="&lt;b&gt;JSON / Auth&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2.2;endArrow=classic;startArrow=classic;fontSize=10;fontColor=#166534;" edge="1" parent="1" source="mob_admin" target="be_service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_be_maps" value="&lt;b&gt;Spatial API&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2.2;endArrow=classic;startArrow=classic;fontSize=10;fontColor=#92400E;" edge="1" parent="1" source="be_service" target="maps_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_be_db" value="&lt;b&gt;TCP 3306 (SQL)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=2.2;endArrow=classic;startArrow=classic;fontSize=10;fontColor=#1E293B;" edge="1" parent="1" source="be_service" target="db_mysql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  
