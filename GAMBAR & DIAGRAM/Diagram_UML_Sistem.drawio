      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        
        <mxCell id="title" value="&lt;b style='font-size:16px;'&gt;PIPELINE INTEGRASI KOMPUTASI ALGORITMA HAVERSINE DISTANCE DAN SIMPLE ADDITIVE WEIGHTING (SAW)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#64748B;'&gt;Sistem Rekomendasi Tempat Kos Berbasis Mobile Android - Kasus Institut Informatika dan Bisnis Darmajaya&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="747" height="60" as="geometry" />
        </mxCell>
        
        
        <mxCell id="step1_header" value="&lt;b&gt;TAHAP 1: INPUT DATA KOORDINAT GEOGRAFIS (SPASIAL)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="150" y="110" width="527" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="box_input_kampus" value="&lt;b style='color:#0F172A;'&gt;Titik Acuan Kampus IIB Darmajaya&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#334155;'&gt;Gerbang Utama:&lt;br&gt;Latitude (&amp;phi;&lt;sub&gt;1&lt;/sub&gt;) = -5.3789&amp;deg;&lt;br&gt;Longitude (&amp;lambda;&lt;sub&gt;1&lt;/sub&gt;) = 105.2538&amp;deg;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="280" height="75" as="geometry" />
        </mxCell>
        
        <mxCell id="box_input_kos" value="&lt;b style='color:#0F172A;'&gt;Titik Alternatif Rumah Kos (A&lt;sub&gt;i&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#334155;'&gt;Reverse Geolocation Google Maps:&lt;br&gt;Latitude (&amp;phi;&lt;sub&gt;2,i&lt;/sub&gt;) &amp;amp; Longitude (&amp;lambda;&lt;sub&gt;2,i&lt;/sub&gt;)&lt;br&gt;Radius Pengamatan: 1 &amp;ndash; 3 km&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="467" y="140" width="280" height="75" as="geometry" />
        </mxCell>
        
        
        <mxCell id="arr_in1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=#2563EB;strokeWidth=2;" edge="1" parent="1" source="box_input_kampus" target="box_haversine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_in2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=#2563EB;strokeWidth=2;" edge="1" parent="1" source="box_input_kos" target="box_haversine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        
        <mxCell id="box_haversine" value="&lt;b style='font-size:13px;color:#1E3A8A;'&gt;MESIN KOMPUTASI SPASIAL: HAVERSINE DISTANCE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#1E293B;'&gt;&lt;b&gt;1.&lt;/b&gt; Konversi Derajat ke Radian: &amp;Delta;&amp;phi; = (&amp;phi;&lt;sub&gt;2,i&lt;/sub&gt; - &amp;phi;&lt;sub&gt;1&lt;/sub&gt;) &amp;times; &amp;pi;/180&amp;deg;, &amp;Delta;&amp;lambda; = (&amp;lambda;&lt;sub&gt;2,i&lt;/sub&gt; - &amp;lambda;&lt;sub&gt;1&lt;/sub&gt;) &amp;times; &amp;pi;/180&amp;deg;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Hitung Kuadrat Setengah Tali Busur: &lt;i&gt;a&lt;/i&gt; = sin&amp;sup2;(&amp;Delta;&amp;phi;/2) + cos(&amp;phi;&lt;sub&gt;1&lt;/sub&gt;) &amp;middot; cos(&amp;phi;&lt;sub&gt;2,i&lt;/sub&gt;) &amp;middot; sin&amp;sup2;(&amp;Delta;&amp;lambda;/2)&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Hitung Sudut Kelengkungan Sferis: &lt;i&gt;c&lt;/i&gt; = 2 &amp;middot; atan2(&amp;radic;a, &amp;radic;(1 - a))&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Jarak Permukaan Lengkung Bumi: &lt;b style='color:#1E40AF;'&gt;d&lt;sub&gt;i&lt;/sub&gt; = R &amp;times; c&lt;/b&gt; (Konstanta R = 6.371.000 meter)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="250" width="667" height="110" as="geometry" />
        </mxCell>
        
        
        <mxCell id="arr_bridge" value="&lt;b style='color:#1E40AF;background-color:#FFFFFF;'&gt;Output Haversine: Jarak Garis Lurus (d&lt;sub&gt;i&lt;/sub&gt;) dlm Meter&lt;/b&gt;&lt;br&gt;&lt;span style='color:#475569;font-size:10px;background-color:#FFFFFF;'&gt;(Dialirkan menjadi Input Kriteria C&lt;sub&gt;2&lt;/sub&gt; SAW)&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#1D4ED8;strokeWidth=2.5;labelBackgroundColor=none;" edge="1" parent="1" source="box_haversine" target="box_bridge_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        
        <mxCell id="box_bridge_group" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="747" height="130" as="geometry" />
        </mxCell>
        
        <mxCell id="lbl_group_criteria" value="&lt;b&gt;PEMBENTUKAN MATRIKS KEPUTUSAN X (m Alternatif &amp;times; 6 Kriteria) &amp;amp; VEKTOR BOBOT W&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor:#334155;" vertex="1" parent="1">
          <mxGeometry x="100" y="415" width="627" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="box_c2" value="&lt;b style='color:#047857;'&gt;Kriteria C&lt;sub&gt;2&lt;/sub&gt;: Jarak ke Kampus&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#065F46;'&gt;&lt;b&gt;Input dari Output Haversine (d&lt;sub&gt;i&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;Sifat Atribut: &lt;b&gt;COST (Biaya)&lt;/b&gt;&lt;br&gt;Satuan: Meter (Nilai Asli Riil)&lt;br&gt;Logika: Semakin kecil semakin baik&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="445" width="220" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="box_c_other" value="&lt;b style='color:#0F172A;'&gt;Kriteria Lainnya (C&lt;sub&gt;1&lt;/sub&gt;, C&lt;sub&gt;3&lt;/sub&gt;, C&lt;sub&gt;4&lt;/sub&gt;, C&lt;sub&gt;5&lt;/sub&gt;, C&lt;sub&gt;6&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#334155;'&gt;&amp;bull; C&lt;sub&gt;1&lt;/sub&gt; Harga Sewa/Tahun (Cost &amp;ndash; Rp)&lt;br&gt;&amp;bull; C&lt;sub&gt;3&lt;/sub&gt; Fasilitas Kamar (Benefit &amp;ndash; Skala 1&amp;ndash;5)&lt;br&gt;&amp;bull; C&lt;sub&gt;4&lt;/sub&gt; Luas Kamar (Benefit &amp;ndash; Skala 1&amp;ndash;5)&lt;br&gt;&amp;bull; C&lt;sub&gt;5&lt;/sub&gt; Kebersihan (Benefit &amp;ndash; Skala 1&amp;ndash;5)&lt;br&gt;&amp;bull; C&lt;sub&gt;6&lt;/sub&gt; Keamanan (Benefit &amp;ndash; Skala 1&amp;ndash;5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="445" width="240" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="box_weights" value="&lt;b style='color:#92400E;'&gt;Vektor Bobot W&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#78350F;'&gt;W = [w&lt;sub&gt;1&lt;/sub&gt;, w&lt;sub&gt;2&lt;/sub&gt;, w&lt;sub&gt;3&lt;/sub&gt;, w&lt;sub&gt;4&lt;/sub&gt;, w&lt;sub&gt;5&lt;/sub&gt;, w&lt;sub&gt;6&lt;/sub&gt;]&lt;br&gt;&amp;sum; w&lt;sub&gt;j&lt;/sub&gt; = 1.00 (100%)&lt;br&gt;Sumber: Rata-rata survei kuesioner mahasiswa / slider preferensi dinamis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="445" width="207" height="80" as="geometry" />
        </mxCell>
        
        
        <mxCell id="arr_to_saw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#059669;strokeWidth=2.5;" edge="1" parent="1" source="box_bridge_group" target="box_saw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        
        <mxCell id="box_saw" value="&lt;b style='font-size:13px;color:#065F46;'&gt;MESIN MULTIKRITERIA: SIMPLE ADDITIVE WEIGHTING (SAW)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#1E293B;'&gt;&lt;b&gt;1. Normalisasi Matriks Keputusan (R):&lt;/b&gt;&lt;br&gt;&amp;bull; Kriteria Cost (C&lt;sub&gt;1&lt;/sub&gt; &amp;amp; C&lt;sub&gt;2&lt;/sub&gt;): &lt;b style='color:#B91C1C;'&gt;R&lt;sub&gt;ij&lt;/sub&gt; = min&lt;sub&gt;i&lt;/sub&gt;(X&lt;sub&gt;ij&lt;/sub&gt;) / X&lt;sub&gt;ij&lt;/sub&gt;&lt;/b&gt; (Nilai terkecil dibagi nilai asli)&lt;br&gt;&amp;bull; Kriteria Benefit (C&lt;sub&gt;3&lt;/sub&gt;, C&lt;sub&gt;4&lt;/sub&gt;, C&lt;sub&gt;5&lt;/sub&gt;, C&lt;sub&gt;6&lt;/sub&gt;): &lt;b style='color:#047857;'&gt;R&lt;sub&gt;ij&lt;/sub&gt; = X&lt;sub&gt;ij&lt;/sub&gt; / max&lt;sub&gt;i&lt;/sub&gt;(X&lt;sub&gt;ij&lt;/sub&gt;)&lt;/b&gt; (Nilai asli dibagi nilai terbesar)&lt;br&gt;&lt;b&gt;2. Akumulasi Perkalian Terbobot (Skor Preferensi):&lt;/b&gt;&lt;br&gt;&lt;b style='color:#065F46;font-size:12px;'&gt;V&lt;sub&gt;i&lt;/sub&gt; = &amp;sum;&lt;sub&gt;j=1..6&lt;/sub&gt; (w&lt;sub&gt;j&lt;/sub&gt; &amp;times; R&lt;sub&gt;ij&lt;/sub&gt;)&lt;/b&gt; (Rentang indeks 0.00 &amp;le; V&lt;sub&gt;i&lt;/sub&gt; &amp;le; 1.00)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="667" height="120" as="geometry" />
        </mxCell>
        
        
        <mxCell id="arr_to_rank" value="&lt;b style='color:#065F46;background-color:#FFFFFF;'&gt;Output SAW: Indeks Preferensi V&lt;sub&gt;i&lt;/sub&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#059669;strokeWidth=2.5;labelBackgroundColor=none;" edge="1" parent="1" source="box_saw" target="box_ranking">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        
        <mxCell id="box_ranking" value="&lt;b style='font-size:13px;color:#78350F;'&gt;HASIL PERANGKINGAN &amp;amp; REKOMENDASI PADA APLIKASI MOBILE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#451A03;'&gt;&amp;bull; Pengurutan Alternatif Kos dari Skor V&lt;sub&gt;i&lt;/sub&gt; Terbesar ke Terkecil (Rank 1 s.d. m)&lt;br&gt;&amp;bull; Kos dengan Skor Tertinggi (&lt;b&gt;Rank 1&lt;/b&gt;) ditandai sebagai &lt;b style='color:#15803D;'&gt;&amp;#129351; Rekomendasi Utama (Terbaik)&lt;/b&gt;&lt;br&gt;&amp;bull; Ditampilkan pada Layar Mobile Flutter Mahasiswa beserta Kartu Rekomendasi, Detail Fasilitas, dan Rute Peta Google Maps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="740" width="667" height="80" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>