        <mxCell id="b_fe" value="&lt;b&gt;FRONTEND LAYER (MOBILE ANDROID)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;strokeFactor=1;dashed=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontSize=12;fontColor=#0369A1;" vertex="1" parent="1">
