  <diagram name="ALUR INTEGRASI METODE HAVERSINE DISTANCE DAN SIMPLE ADDITIVE WEIGHTING (SAW)" id="AocMM8NuypSRw-lxMdgs">
    <mxGraphModel dx="1173" dy="724" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#000000;" value="&lt;b style=&quot;font-size: 16px; color: rgb(0, 0, 0);&quot;&gt;ALUR INTEGRASI METODE HAVERSINE DISTANCE DAN SIMPLE ADDITIVE WEIGHTING (SAW)&lt;/b&gt;" vertex="1">
          <mxGeometry height="60" width="747" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="step1_header" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;" value="&lt;b style=&#39;color:#000000;&#39;&gt;TAHAP 1: INPUT DATA TITIK KOORDINAT LOKASI&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="527" x="150" y="105" as="geometry" />
        </mxCell>
        <mxCell id="box_input_kampus" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#000000;" value="&lt;b style=&#39;color:#000000;&#39;&gt;Titik Acuan Kampus IIB Darmajaya&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#000000;&#39;&gt;Koordinat Gerbang Utama Kampus:&lt;br&gt;&lt;b&gt;Lintang = -5.3789&amp;deg; LS | Bujur = 105.2538&amp;deg; BT&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="75" width="300" x="80" y="135" as="geometry" />
        </mxCell>
        <mxCell id="box_input_kos" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#000000;" value="&lt;b style=&#39;color:#000000;&#39;&gt;Titik Lokasi Alternatif Kos (A&lt;sub&gt;i&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#000000;&#39;&gt;Pendataan Titik Lokasi (Google Maps):&lt;br&gt;&lt;b&gt;Koordinat Lintang &amp;amp; Bujur Setiap Tempat Kos&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="75" width="300" x="447" y="135" as="geometry" />
        </mxCell>
        <mxCell id="arr_in1" edge="1" parent="1" source="box_input_kampus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=2;" target="box_haversine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_in2" edge="1" parent="1" source="box_input_kos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=2;" target="box_haversine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box_haversine" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;fontColor=#000000;" value="&lt;b style=&#39;font-size:13px;color:#000000;&#39;&gt;TAHAP 2: PERHITUNGAN JARAK LOKASI (METODE HAVERSINE DISTANCE)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#000000;&#39;&gt;&lt;b&gt;1.&lt;/b&gt; Menghitung selisih koordinat lintang (&amp;Delta;&amp;phi;) dan bujur (&amp;Delta;&amp;lambda;) antara kampus dan kos dalam radian&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Menghitung sudut kelengkungan jarak menggunakan rumus trigonometri Haversine&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Menghasilkan jarak lokasi kos ke kampus: &lt;b style=&#39;color:#000000;&#39;&gt;d&lt;sub&gt;i&lt;/sub&gt; = R &amp;times; c&lt;/b&gt; (dalam satuan meter)&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="667" x="80" y="250" as="geometry" />
        </mxCell>
        <mxCell id="arr_bridge" edge="1" parent="1" source="box_haversine" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=2.5;labelBackgroundColor=#FFFFFF;fontColor=#000000;" target="box_bridge_group" value="&lt;b style=&#39;color:#000000;background-color:#FFFFFF;&#39;&gt;Hasil Jarak Haversine (d&lt;sub&gt;i&lt;/sub&gt;) Otomatis Menjadi Nilai Kriteria Jarak (C&lt;sub&gt;2&lt;/sub&gt;)&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box_bridge_group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;align=center;verticalAlign=top;spacingTop=6;fontColor=#000000;" value="" vertex="1">
          <mxGeometry height="135" width="747" x="40" y="405" as="geometry" />
        </mxCell>
        <mxCell id="lbl_group_criteria" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#000000;" value="&lt;b style=&#39;color:#000000;&#39;&gt;TAHAP 3: PENYUSUNAN NILAI 6 KRITERIA KOS &amp;amp; BOBOT PREFERENSI MAHASISWA&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="667" x="80" y="412" as="geometry" />
        </mxCell>
        <mxCell id="box_c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#000000;" value="&lt;b style=&#39;color:#000000;&#39;&gt;Kriteria Jarak ke Kampus (C&lt;sub&gt;2&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#000000;&#39;&gt;&lt;b&gt;Bersumber dari Hasil Haversine (d&lt;sub&gt;i&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;Sifat Kriteria: &lt;b&gt;Cost (Biaya)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Semakin dekat jarak, nilai semakin tinggi&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="82" width="220" x="60" y="442" as="geometry" />
        </mxCell>
        <mxCell id="box_c_other" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontColor=#000000;" value="&lt;b style=&quot;color: rgb(0, 0, 0);&quot;&gt;5 Kriteria Penilaian Kos Lainnya&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(0, 0, 0);&quot;&gt;• C&lt;sub&gt;1&lt;/sub&gt; Harga Sewa (Cost: Semakin murah semakin baik)&lt;br&gt;• C&lt;sub&gt;3&lt;/sub&gt; Fasilitas &amp;amp; C&lt;sub&gt;4&lt;/sub&gt; Luas Kamar (Benefit: Skala 1–5)&lt;br&gt;• C&lt;sub&gt;5&lt;/sub&gt; Kebersihan &amp;amp; C&lt;sub&gt;6&lt;/sub&gt; Keamanan (Benefit: Skala 1–5)&lt;/font&gt;" vertex="1">
          <mxGeometry height="82" width="250" x="295" y="442" as="geometry" />
        </mxCell>
        <mxCell id="box_weights" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#000000;" value="&lt;b style=&#39;color:#000000;&#39;&gt;Bobot Kriteria (W)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#000000;&#39;&gt;&lt;b&gt;Bobot W&lt;sub&gt;1&lt;/sub&gt; s.d. W&lt;sub&gt;6&lt;/sub&gt; (Total = 100%)&lt;/b&gt;&lt;br&gt;Diperoleh dari kuesioner /&lt;br&gt;pilihan prioritas mahasiswa&lt;/font&gt;" vertex="1">
          <mxGeometry height="82" width="207" x="560" y="442" as="geometry" />
        </mxCell>
        <mxCell id="arr_to_saw" edge="1" parent="1" source="box_bridge_group" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=2.5;" target="box_saw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box_saw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;fontColor=#000000;" value="&lt;b style=&#39;font-size:13px;color:#000000;&#39;&gt;TAHAP 4: PERHITUNGAN &amp;amp; PERANGKINGAN METODE SAW&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#000000;&#39;&gt;&lt;b&gt;1. Normalisasi Matriks (R):&lt;/b&gt; Menyamakan skala seluruh kriteria ke rentang 0 s.d. 1&lt;br&gt;&amp;bull; Kriteria Cost (C&lt;sub&gt;1&lt;/sub&gt;, C&lt;sub&gt;2&lt;/sub&gt;): R&lt;sub&gt;ij&lt;/sub&gt; = Nilai Terkecil / Nilai Kos | &amp;bull; Kriteria Benefit (C&lt;sub&gt;3&lt;/sub&gt;&amp;ndash;C&lt;sub&gt;6&lt;/sub&gt;): R&lt;sub&gt;ij&lt;/sub&gt; = Nilai Kos / Nilai Terbesar&lt;br&gt;&lt;b&gt;2. Perhitungan Nilai Akhir Preferensi (V&lt;sub&gt;i&lt;/sub&gt;):&lt;/b&gt; Mengalikan nilai normalisasi dengan bobot kriteria&lt;br&gt;&lt;b style=&#39;color:#000000;font-size:12px;&#39;&gt;Rumus Nilai Akhir: V&lt;sub&gt;i&lt;/sub&gt; = &amp;sum; (W&lt;sub&gt;j&lt;/sub&gt; &amp;times; R&lt;sub&gt;ij&lt;/sub&gt;) (untuk kriteria j = 1 sampai 6)&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="667" x="80" y="575" as="geometry" />
        </mxCell>
        <mxCell id="arr_to_rank" edge="1" parent="1" source="box_saw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=2.5;" target="box_ranking">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box_ranking" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;fontColor=#000000;" value="&lt;b style=&#39;font-size:13px;color:#000000;&#39;&gt;HASIL AKHIR: PERINGKAT REKOMENDASI TEMPAT KOS TERBAIK&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#000000;&#39;&gt;&amp;bull; Mengurutkan tempat kos dari nilai akhir (V&lt;sub&gt;i&lt;/sub&gt;) tertinggi hingga terendah&lt;br&gt;&amp;bull; Tempat kos dengan nilai V&lt;sub&gt;i&lt;/sub&gt; tertinggi menjadi &lt;b style=&#39;color:#000000;&#39;&gt;Peringkat 1 (Rekomendasi Terbaik)&lt;/b&gt;&lt;br&gt;&amp;bull; Menampilkan daftar rekomendasi kos beserta harga, jarak, fasilitas, dan rute peta pada aplikasi&lt;/font&gt;" vertex="1">
          <mxGeometry height="85" width="667" x="80" y="730" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
